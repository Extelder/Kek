--- !u!114 &4786375125296619185
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4287461291614739398}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 910f3e8a4731f924ea84a4cf77a263a5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _saveKey: 'Kernel '
  _dialogue:
  - <Name>k__BackingField: 'Kernel '
    <Color>k__BackingField: {r: 0.764151, g: 0.37842843, b: 0.05406728, a: 1}
    <Replicas>k__BackingField:
    - HasEvent: 0
      <Text>k__BackingField: Oh hey stranger
      <delay>k__BackingField: 3
      <DialogueEvent>k__BackingField:
        rid: -2
    - HasEvent: 0
      <Text>k__BackingField: I`m to a prisoner, but i can left <color=red>HIM</color=red>,
        now each cycle i <color=blue>researching</color=blue> all of this shit!
      <delay>k__BackingField: 6
      <DialogueEvent>k__BackingField:
        rid: -2
    - HasEvent: 0
      <Text>k__BackingField: Oh sorry i need to work, <color=green>see you soon</color=green>!
      <delay>k__BackingField: 5
      <DialogueEvent>k__BackingField:
        rid: -2
  - <Name>k__BackingField: 'Kernel '
    <Color>k__BackingField: {r: 0.7647059, g: 0.3764706, b: 0.05490196, a: 1}
    <Replicas>k__BackingField:
    - HasEvent: 0
      <Text>k__BackingField: Glad to see prisoner!
      <delay>k__BackingField: 4
      <DialogueEvent>k__BackingField:
        rid: -2
    - HasEvent: 0
      <Text>k__BackingField: I heard about <color=green>water bomb </color=green>in
        this places, i think it is not  danger, except <color=red>poison smoke </color=red>
      <delay>k__BackingField: 10
      <DialogueEvent>k__BackingField:
        rid: -2
  - <Name>k__BackingField: 'Kernel '
    <Color>k__BackingField: {r: 0.7647059, g: 0.3764706, b: 0.05490196, a: 1}
    <Replicas>k__BackingField:
    - HasEvent: 0
      <Text>k__BackingField: Oh hi!`
      <delay>k__BackingField: 4
      <DialogueEvent>k__BackingField:
        rid: -2
    - HasEvent: 0
      <Text>k__BackingField: I`m here alone, cause of it i really like to see you
        my friend
      <delay>k__BackingField: 10
      <DialogueEvent>k__BackingField:
        rid: -2
    - HasEvent: 1
      <Text>k__BackingField: Here <color=blue>take it</color=blue>, can help in this
        place, trust me
      <delay>k__BackingField: 10
      <DialogueEvent>k__BackingField:
        rid: 25188164530077696
  - <Name>k__BackingField: 'Kernel '
    <Color>k__BackingField: {r: 0.7647059, g: 0.3764706, b: 0.05490196, a: 1}
    <Replicas>k__BackingField:
    - HasEvent: 0
      <Text>k__BackingField: Shit, are you still alive?
      <delay>k__BackingField: 4
      <DialogueEvent>k__BackingField:
        rid: -2
    - HasEvent: 0
      <Text>k__BackingField: Oh, i forgot we in loop(
      <delay>k__BackingField: 3
      <DialogueEvent>k__BackingField:
        rid: -2
    - HasEvent: 0
      <Text>k__BackingField: Good look, bye!
      <delay>k__BackingField: 2
      <DialogueEvent>k__BackingField:
        rid: -2
    - HasEvent: 1
      <Text>k__BackingField: Wait wait, i can a new small present for you - <color=blue>here</color=blue>
      <delay>k__BackingField: 6
      <DialogueEvent>k__BackingField:
        rid: 25188164530077697
  - <Name>k__BackingField: 'Kernel '
    <Color>k__BackingField: {r: 0.7647059, g: 0.3764706, b: 0.05490196, a: 1}
    <Replicas>k__BackingField:
    - HasEvent: 1
      <Text>k__BackingField: Do you hungry?
      <delay>k__BackingField: 4
      <DialogueEvent>k__BackingField:
        rid: 25188164530077698
  _repeatDialouge:
    <Name>k__BackingField: 'Kernel '
    <Color>k__BackingField: {r: 0.7647059, g: 0.3764706, b: 0.05490196, a: 1}
    <Replicas>k__BackingField:
    - HasEvent: 0
      <Text>k__BackingField: Good luck, prisoner! My advice - maybe <color=red>HIM</color=red>
        have an eat limits?
      <delay>k__BackingField: 5
      <DialogueEvent>k__BackingField:
        rid: -2
  _lookAtDuration: 1
  _head: {fileID: 1945346732621509025}
  references:
    version: 2
    RefIds:
    - rid: -2
      type: {class: , ns: , asm: }
    - rid: 25188164530077696
      type: {class: SpawnItemOnPlaceDialogueEvent, ns: , asm: Assembly-CSharp}
      data:
